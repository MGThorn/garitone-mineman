{
	"schemaVersion": 1,
	"id": "mineman",
	"version": "${version}",
	"name": "Garitone Mineman",
	"description": "Client-side mining assistant built on Baritone and MaLiLib: mining tasks, storage points, auto eat, ESP and inventory tools.",
	"authors": [
		"MGThorn"
	],
	"contact": {
		"homepage": "https://github.com/MGThorn/garitone-mineman",
		"sources": "https://github.com/MGThorn/garitone-mineman",
		"issues": "https://github.com/MGThorn/garitone-mineman/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/mineman/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.mgthorn.garitonemineman.client.GaritoneMinemanClient"
		],
		"modmenu": [
			"io.github.mgthorn.garitonemineman.client.compat.modmenu.ModMenuImpl"
		]
	},
	"mixins": [
		{
			"config": "mineman.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"malilib": ">=0.27.20",
		"litematica": ">=0.26.16",
		"itemscroller": ">=0.30.8",
		"minihud": ">=0.38.16",
		"tweakeroo": ">=0.27.15"
	},
	"suggests": {
		"modmenu": ">=17.0.0"
	}
}
