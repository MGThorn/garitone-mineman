{
	"schemaVersion": 1,
	"id": "mineman",
	"version": "${version}",
	"name": "Mineman",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mineman/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		],
		"modmenu": [
			"com.example.client.compat.modmenu.ModMenuImpl"
		]
	},
	"mixins": [
		"mineman.mixins.json",
		{
			"config": "mineman.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": ">=17.0.0"
	}
}